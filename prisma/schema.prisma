// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EquipmentStatus {
  RECEBIDO
  EM_ANALISE
  REPARO
  FINALIZADO
  OS_CANCELADA
}

enum Role {
  ADMIN
  TECHNICIAN
}

enum ServiceOrderStatus {
  ABERTA
  FINALIZADA
  CANCELADA
}

// 1. Mudamos de Technician para User e o mapeamento para "users"
model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String
  phone                String?
  avatar_url           String?
  active               Boolean   @default(true)
  role                 Role      @default(TECHNICIAN)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  created_at           DateTime  @default(now())

  opened_service_orders ServiceOrder[] @relation("OpenedBy")
  closed_service_orders ServiceOrder[] @relation("ClosedBy")

  @@map("users")
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  email         String?
  phone         String?
  zip_code      String?
  city          String
  state         String
  address       String?
  active        Boolean        @default(true)
  created_at    DateTime       @default(now())
  equipments    Equipment[]
  serviceOrders ServiceOrder[]

  @@map("customers")
}

model Equipment {
  id             String          @id @default(uuid())
  customerId     String?
  serial_number  String          @unique
  description    String
  received_at    DateTime        @default(now())
  returned_at    DateTime?
  active         Boolean         @default(true)
  status         EquipmentStatus @default(RECEBIDO)
  service_orders ServiceOrder[]
  customer       Customer?       @relation(fields: [customerId], references: [id])

  @@map("equipments")
}

model ServiceOrder {
  id          String @id @default(uuid())
  number      Int    @unique @default(autoincrement())
  customerId  String
  equipmentId String

  openedById String
  closedById String?

  opened_at            DateTime           @default(now())
  closed_at            DateTime?
  problem_description  String
  solution_description String?
  status               ServiceOrderStatus @default(ABERTA)
  cancellation_reason  String?
  parts_replaced       PartReplaced[]

  openedBy User  @relation("OpenedBy", fields: [openedById], references: [id])
  clodedBy User? @relation("ClosedBy", fields: [closedById], references: [id])

  equipment Equipment? @relation(fields: [equipmentId], references: [id])
  customer  Customer   @relation(fields: [customerId], references: [id])

  @@map("service_orders")
}

model PartReplaced {
  id             String       @id @default(uuid())
  serviceOrderId String
  part_name      String
  part_code      String?
  cost           Decimal?     @db.Decimal(10, 2)
  service_order  ServiceOrder @relation(fields: [serviceOrderId], references: [id])

  @@map("parts_replaced")
}
